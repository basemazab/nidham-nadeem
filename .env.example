# ===== Groq (السمع + التفكير) =====
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
WHISPER_MODEL=whisper-large-v3-turbo

# ===== الصوت =====
# edge | groq_orpheus | elevenlabs | gemini | hakim
TTS_ENGINE=edge
EDGE_VOICE=ar-EG-SalmaNeural
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# GEMINI_API_KEY=
# HAKIM_API_KEY=

# ===== قفل الدخول =====
# سيبه فاضي = الموقع مفتوح للكل.
# لو حطيت قيمة = مفيش حد يدخل غير بكود صح: إما ACCESS_KEY نفسه أو كود ديمو من demo_accounts.json
ACCESS_KEY=

# ===== حسابات الديمو =====
# ملف حسابات العملاء. كل حساب = لينك خاص: https://<الدومين>/?k=<key>
DEMO_ACCOUNTS_FILE=demo_accounts.json
# لو عايز تخفي كود عميل عن الريبو: حط في الملف "key": "env:DEMO_KEY_MUSHKAH" وحط القيمة هنا
# DEMO_KEY_MUSHKAH=

# ===== تسليم الـ Lead لباسم =====
# 1 = مفعّل (افتراضي). 0 = إيقاف الاستخراج.
LEAD_CAPTURE=1
# موديل الاستخراج (افتراضي = GROQ_MODEL). ممكن موديل أرخص/أسرع.
# LEAD_EXTRACT_MODEL=
# إشعار Telegram: اعمل بوت من @BotFather وخد chat_id بتاعك.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# أو أي Webhook (n8n / Make / Zapier / CRM نِظام) بيستقبل POST JSON.
# LEAD_WEBHOOK_URL=
# ملف حفظ الـ leads محليًا (JSON Lines). يتقرأ من /api/leads?k=ACCESS_KEY (كود الأدمن فقط، مش كود ديمو)
LEADS_FILE=leads.jsonl
