# ===== Groq (السمع + التفكير) =====
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
WHISPER_MODEL=whisper-large-v3-turbo

# ===== الصوت =====
# edge | groq_orpheus | elevenlabs | gemini | hakim
TTS_ENGINE=edge
EDGE_VOICE=ar-EG-SalmaNeural
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# GEMINI_API_KEY=
# HAKIM_API_KEY=

# ===== قفل الدخول =====
# سيبه فاضي = الموقع مفتوح للكل.
# لو حطيت قيمة = مفيش حد يدخل غير بكود صح: إما ACCESS_KEY نفسه أو كود ديمو من demo_accounts.json
ACCESS_KEY=

# ===== حسابات الديمو =====
# ملف حسابات العملاء. كل حساب = لينك خاص: https://<الدومين>/?k=<key>
DEMO_ACCOUNTS_FILE=demo_accounts.json
# لو عايز تخفي كود عميل عن الريبو: حط في الملف "key": "env:DEMO_KEY_MUSHKAH" وحط القيمة هنا
# DEMO_KEY_MUSHKAH=

# ===== الحماية من الإغراق (rate limiting) =====
# كل رد صوتي بيكلّف نداء مدفوع (Groq + الصوت)، فبنحدد العدد. 0 = الحد ده مقفول.
# أقصى عدد ردود لنفس الزائر (نفس الـ IP) في 5 دقايق، وفي الساعة
TALK_PER_IP_5MIN=40
TALK_PER_IP_HOUR=150
# أقصى عدد ردود للموقع كله في الساعة = سقف الفاتورة لو حد حاول يغرق الموقع
TALK_GLOBAL_HOUR=600
# عدد مرات الكود الغلط المسموح بيها لنفس الـ IP في ربع ساعة قبل ما يتقفل مؤقتًا (ضد تخمين لينكات العملاء)
BAD_KEY_PER_IP_15MIN=10
# أقصى حجم لتسجيل صوتي واحد بالميجا
MAX_UPLOAD_MB=10
