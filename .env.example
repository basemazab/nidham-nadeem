# --- أساسي ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
WHISPER_MODEL=whisper-large-v3-turbo
ACCESS_KEY=

# --- الصوت (edge | groq_orpheus | elevenlabs | gemini | hakim) ---
TTS_ENGINE=edge
EDGE_VOICE=ar-EG-SalmaNeural
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
HAKIM_API_KEY=

# --- تسليم الـ Lead لباسم ---
# 1 = مفعّل (افتراضي). 0 = إيقاف الاستخراج.
LEAD_CAPTURE=1
# موديل الاستخراج (افتراضي = GROQ_MODEL). ممكن موديل أرخص/أسرع.
LEAD_EXTRACT_MODEL=
# إشعار Telegram: اعمل بوت من @BotFather وخد chat_id بتاعك.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# أو أي Webhook (n8n / Make / Zapier / CRM نِظام) بيستقبل POST JSON.
LEAD_WEBHOOK_URL=
# ملف حفظ الـ leads محليًا (JSON Lines). يتقرأ من /api/leads?k=ACCESS_KEY
LEADS_FILE=leads.jsonl
